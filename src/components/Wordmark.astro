---
interface Props { light?: boolean; logo?: string; name?: string; highlight?: string; byline?: string }
const { light = false, logo = '/images/logo-mark.png', name = 'NO.KIT.LAB', highlight = '', byline = '' } = Astro.props;
// The highlighted word (e.g. KIT) is shown in teal.
const at = highlight ? name.indexOf(highlight) : -1;
const parts = at >= 0 ? [name.slice(0, at), name.slice(at, at + highlight.length), name.slice(at + highlight.length)] : [name, '', ''];
---
<span class:list={['wordmark', { light }]}>
  <img src={logo} alt="" width="40" height="39" />
  <span class="wm-words">
    <span class="wm-text">{parts[0]}{parts[1] && <b>{parts[1]}</b>}{parts[2]}</span>
    {byline && <span class="wm-by">{byline}</span>}
  </span>
</span>
<style>
  .wordmark { display: inline-flex; align-items: center; gap: 12px; }
  .wordmark img { width: 40px; height: auto; }
  .wm-words { display: inline-flex; flex-direction: column; gap: 5px; }
  .wm-text {
    font-family: var(--font-head); font-weight: 500; font-size: 1.35rem;
    letter-spacing: 0.14em; color: var(--navy); line-height: 1;
  }
  .wm-text b { color: var(--teal); font-weight: 500; }
  .wm-by { font-family: var(--font-body); font-size: 0.74rem; letter-spacing: 0.04em; color: var(--slate); line-height: 1; }
  .light .wm-text { color: #fff; }
  .light .wm-text b { color: #5fc4bb; }
  .light .wm-by { color: #aab1cc; }
  .light img { background: #fff; border-radius: 50%; padding: 3px; }
</style>
