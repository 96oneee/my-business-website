---
import Divider from './Divider.astro';
import Helix from './Helix.astro';
interface Props { eyebrow?: string; title: string; intro?: string }
const { eyebrow, title, intro } = Astro.props;
---
<section class="page-hero">
  <Helix class="helix" />
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <Divider />
    {intro && <p class="lead">{intro}</p>}
    <slot />
  </div>
</section>
