---
// Full-screen animated logo shown when a visitor opens the site.
// MODE decides who sees it:
//   'test'     only links with ?intro (e.g. nokitlab.com/?intro), for trying it out
//   'everyone' every visitor, once per browser visit
//   'off'      nobody
const MODE: 'test' | 'everyone' | 'off' = 'everyone';

interface Props { name?: string; highlight?: string; byline?: string; tagline?: string }
const { name = 'NO.KIT.LAB', highlight = 'KIT', byline = 'by Dr. Athar Khalil', tagline = '' } = Astro.props;
const at = highlight ? name.indexOf(highlight) : -1;
const letters = [...name].map((ch, i) => ({ ch, hi: at >= 0 && i >= at && i < at + highlight.length }));
const [tag1, ...tagRest] = tagline.split(/(?<=\.)\s+/);
const tag2 = tagRest.join(' ');
---
{MODE !== 'off' && (
  <div id="intro" class="intro" aria-hidden="true">
    <div class="stage">
      <div class="emblem">
        <span class="ring"></span>
        <span class="ring r2"></span>
        <img src="/images/logo-mark.png" alt="" width="400" height="386" />
      </div>
      <div class="name">
        {letters.map((l, i) => <span class:list={{ hi: l.hi }} style={`--i:${i}`}>{l.ch}</span>)}
      </div>
      {byline && <p class="by">{byline}</p>}
      <div class="rule"><span></span><i></i><span></span></div>
      {tagline && (
        <p class="tag"><span>{tag1}</span>{tag2 && <span class="t2">{tag2}</span>}</p>
      )}
    </div>
    <button type="button" class="skip-intro" tabindex="-1">Skip</button>
  </div>
  <script is:inline define:vars={{ MODE }}>
    (function () {
      var el = document.getElementById('intro');
      var q = new URLSearchParams(location.search);
      var show = q.has('intro');
      if (!show && MODE === 'everyone') {
        try { show = !sessionStorage.getItem('introSeen'); sessionStorage.setItem('introSeen', '1'); } catch (e) { show = false; }
      }
      if (!show) { el.remove(); return; }
      var root = document.documentElement;
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      el.classList.add('on');
      if (reduce) el.classList.add('calm');
      root.style.overflow = 'hidden';
      var done = false;
      function finish() {
        if (done) return;
        done = true;
        el.classList.add('out');
        root.style.overflow = '';
        setTimeout(function () { el.remove(); }, 750);
      }
      setTimeout(finish, reduce ? 1600 : 4200);
      el.addEventListener('click', finish);
      addEventListener('keydown', finish, { once: true });
    })();
  </script>
)}

<style>
  .intro {
    display: none; position: fixed; inset: 0; z-index: 1000;
    background: radial-gradient(circle at 50% 42%, #ffffff 0%, #f4f8fa 55%, #e8f1f2 100%);
    align-items: center; justify-content: center; cursor: pointer;
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(.7, 0, .3, 1);
  }
  .intro.on { display: flex; }
  .intro.out { opacity: 0; transform: translateY(-4%); pointer-events: none; }

  .stage { display: flex; flex-direction: column; align-items: center; padding: 0 16px; text-align: center; }

  .emblem { position: relative; width: min(62vw, 320px, 40vh); aspect-ratio: 400 / 386; }
  .emblem img {
    width: 100%; height: auto; position: relative;
    clip-path: circle(0% at 50% 50%);
    animation: reveal 1.2s cubic-bezier(.2, .7, .2, 1) 0.15s forwards;
  }
  .ring {
    position: absolute; left: 50%; top: 50%; width: 100%; aspect-ratio: 1;
    border: 2px solid var(--teal); border-radius: 50%;
    transform: translate(-50%, -50%) scale(0.4); opacity: 0;
    animation: pulse 1.6s ease-out 0.7s forwards;
  }
  .ring.r2 { border-color: var(--navy); animation-delay: 0.95s; }

  .name {
    margin-top: 32px; font-family: var(--font-head); font-weight: 500;
    font-size: clamp(2.3rem, 9.5vw, 4.3rem); letter-spacing: 0.16em; color: var(--navy); line-height: 1;
    padding-left: 0.16em; /* balances the trailing letter-spacing */
  }
  .name span {
    display: inline-block; opacity: 0; transform: translateY(0.5em);
    animation: rise 0.55s cubic-bezier(.2, .7, .2, 1) forwards;
    animation-delay: calc(1.05s + var(--i) * 0.06s);
  }
  .name .hi { color: var(--teal); }

  .by {
    margin: 14px 0 0; font-family: var(--font-head); font-weight: 400;
    font-size: clamp(1rem, 3.6vw, 1.35rem); letter-spacing: 0.08em; color: var(--slate);
    opacity: 0; transform: translateY(0.4em); animation: rise 0.6s ease-out 1.75s forwards;
  }

  .rule { display: flex; align-items: center; gap: 10px; margin-top: 22px; width: min(82vw, 440px); }
  .rule span { flex: 1; height: 2px; transform: scaleX(0); animation: grow 0.6s ease-out 1.8s forwards; }
  .rule span:first-child { background: var(--navy); transform-origin: right; }
  .rule span:last-child { background: var(--teal); transform-origin: left; }
  .rule i { width: 9px; height: 9px; border-radius: 50%; background: var(--teal); transform: scale(0); animation: pop 0.4s ease-out 1.7s forwards; }

  .tag {
    margin: 22px 0 0; display: flex; flex-direction: column; gap: 6px;
    font-family: var(--font-body); font-size: clamp(0.8rem, 3.1vw, 1.15rem);
    letter-spacing: 0.32em; text-transform: uppercase; color: var(--navy);
  }
  .tag span { opacity: 0; animation: fade 0.7s ease-out 2.2s forwards; }
  .tag .t2 { color: var(--teal); animation-delay: 2.45s; }

  .skip-intro {
    position: absolute; right: 20px; bottom: 20px; background: none; border: 1px solid var(--line);
    border-radius: 999px; padding: 6px 16px; font: 500 0.85rem var(--font-head); letter-spacing: 0.08em;
    color: var(--slate); cursor: pointer; opacity: 0; animation: fade 0.5s ease-out 1s forwards;
  }
  .skip-intro:hover { color: var(--teal); border-color: var(--teal); }

  @keyframes reveal {
    0% { clip-path: circle(0% at 50% 50%); transform: scale(0.85) rotate(-10deg); }
    100% { clip-path: circle(75% at 50% 50%); transform: none; }
  }
  @keyframes pulse {
    0% { opacity: 0.55; transform: translate(-50%, -50%) scale(0.6); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(1.45); }
  }
  @keyframes rise { to { opacity: 1; transform: none; } }
  @keyframes grow { to { transform: scaleX(1); } }
  @keyframes pop { 60% { transform: scale(1.4); } 100% { transform: scale(1); } }
  @keyframes fade { to { opacity: 1; } }

  /* Visitors who ask their device for less motion get a simple fade. */
  .calm *, .calm *::before { animation: none !important; }
  .calm .emblem img { clip-path: none; }
  .calm .name span, .calm .by, .calm .tag span, .calm .rule span, .calm .rule i, .calm .skip-intro { opacity: 1; transform: none; }
  .calm .ring { display: none; }
</style>
