---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getNews, formatDate } from '../../lib/site';
const news = await getNews();
---
<Base title="News" description="News and updates from NO.KIT.LAB.">
  <PageHero eyebrow="News" title="Lab news" intro="New papers, new members, conferences and milestones." />
  <section class="section">
    <div class="container">
      {news.length === 0 ? <p class="muted">No news yet. Check back soon.</p> : (
        <div class="grid grid--3">
          {news.map((n) => (
            <a class="card item" href={`/news/${n.id}`}>
              {n.data.image ? <img src={n.data.image} alt="" loading="lazy" /> : <div class="ph"><img src="/images/logo-mark.png" alt="" /></div>}
              <div class="b">
                <p class="date">{formatDate(n.data.date)}</p>
                <h3>{n.data.title}</h3>
                <p class="muted">{n.data.summary}</p>
                <div class="tags">{n.data.tags.map((t) => <span class="chip">{t}</span>)}</div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
<style>
  .item { overflow: hidden; }
  .item > img, .ph { aspect-ratio: 16 / 9; width: 100%; object-fit: cover; }
  .ph { background: var(--teal-light); display: flex; align-items: center; justify-content: center; }
  .ph img { width: 30%; opacity: 0.8; }
  .b { padding: 22px 24px 26px; }
  .date { color: var(--teal); font-size: 0.85rem; font-weight: 500; margin: 0 0 6px; }
  .b .muted { font-size: 0.94rem; }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; }
</style>
