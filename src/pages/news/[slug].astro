---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Gallery from '../../components/Gallery.astro';
import { getNews, getSections, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  return (await getNews()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { news: sec } = await getSections();
const { Content } = await render(post);
const photos = (post.data.gallery ?? []).filter((src): src is string => !!src);
const cover = post.data.image || photos[0];
// Without a cover image the first gallery photo is used as the cover.
const extra = post.data.image ? photos : photos.slice(1);
---
<Base title={post.data.title} description={post.data.summary || undefined} image={cover || undefined}>
  <article class="section">
    <div class="container narrow">
      <a class="back" href="/news"><Icon name="arrow-left" size={18} /> Back to {sec.menu}</a>
      <p class="date">{formatDate(post.data.date)}</p>
      <h1>{post.data.title}</h1>
      <div class="divider"><span></span></div>
      {post.data.summary && <p class="lead">{post.data.summary}</p>}
      {cover && <img class="cover" src={cover} alt="" />}
      <div class="prose"><Content /></div>
      <Gallery images={extra} />
    </div>
  </article>
</Base>
<style>
  .narrow { max-width: 820px; }
  .back { display: inline-flex; align-items: center; gap: 6px; color: var(--slate); text-decoration: none; font-size: 0.92rem; margin-bottom: 28px; }
  .date { color: var(--teal); font-weight: 500; margin-bottom: 8px; }
  h1 { font-size: clamp(2rem, 4vw, 2.8rem); }
  .cover { width: 100%; border-radius: var(--radius); margin: 12px 0 36px; }
  .prose { font-size: 1.08rem; max-width: none; }
  .prose :global(img) { border-radius: 10px; margin: 24px 0; }
</style>
