---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getNews, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  return (await getNews()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.summary} image={post.data.image || undefined}>
  <article class="section">
    <div class="container narrow">
      <a class="back" href="/news"><Icon name="arrow-left" size={18} /> All news</a>
      <p class="date">{formatDate(post.data.date)}</p>
      <h1>{post.data.title}</h1>
      <div class="divider"><span></span></div>
      {post.data.summary && <p class="lead">{post.data.summary}</p>}
      {post.data.image && <img class="cover" src={post.data.image} alt="" />}
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>
<style>
  .narrow { max-width: 820px; }
  .back { display: inline-flex; align-items: center; gap: 6px; color: var(--slate); text-decoration: none; font-size: 0.92rem; margin-bottom: 28px; }
  .date { color: var(--teal); font-weight: 500; margin-bottom: 8px; }
  h1 { font-size: clamp(2rem, 4vw, 2.8rem); }
  .cover { width: 100%; border-radius: var(--radius); margin: 12px 0 36px; }
  .prose { font-size: 1.08rem; max-width: none; }
  .prose :global(img) { border-radius: 10px; margin: 24px 0; }
</style>
