---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { md } from '../lib/site';

const page = (await getEntry('pages', 'about'))!.data;
const icons = ['sparkle', 'calendar', 'users', 'dna'];
---
<Base title="About" description={page.intro}>
  <PageHero eyebrow="About" title={page.title} intro={page.intro} />
  <section class="section">
    <div class="container">
      {page.image && <img class="about-img" src={page.image} alt="The NO.KIT.LAB team" />}
      <div class="blocks">
        {page.sections.map((sec, i) => (
          <article class="block">
            <span class="ic"><Icon name={icons[i % icons.length]} size={26} /></span>
            <div>
              <h2>{sec.heading}</h2>
              <div class="prose" set:html={md(sec.text)} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--tint">
    <div class="container center">
      <h2>Explore what we do</h2>
      <div class="divider center"><span></span></div>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/research">Our research <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="/people">Meet the team</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .about-img { width: 100%; max-height: 520px; object-fit: cover; border-radius: var(--radius); margin-bottom: 72px; }
  .blocks { display: grid; gap: 0; max-width: 900px; }
  .block { display: grid; grid-template-columns: 64px 1fr; gap: 28px; padding: 44px 0; border-bottom: 1px solid var(--line); }
  .block:first-child { padding-top: 0; }
  .block:last-child { border-bottom: 0; }
  .block h2 { font-size: clamp(1.5rem, 2.4vw, 1.9rem); }
  .block .prose { font-size: 1.08rem; }
  .ic { width: 56px; height: 56px; border-radius: 50%; background: var(--teal-light); color: var(--teal); display: flex; align-items: center; justify-content: center; }
  @media (max-width: 560px) { .block { grid-template-columns: 1fr; gap: 14px; } }
</style>
