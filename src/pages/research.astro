---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { getResearch } from '../lib/site';

const intro = (await getEntry('pages', 'research-intro'))!.data;
const themes = await Promise.all(
  (await getResearch()).map(async (t) => ({ t, Content: (await render(t)).Content })),
);
---
<Base title="Research" description={intro.intro}>
  <PageHero eyebrow="Research" title={intro.title} intro={intro.intro}>
    <nav class="jump" aria-label="Research themes">
      {themes.map(({ t }, i) => <a href={`#${t.id}`}><span>0{i + 1}</span>{t.data.title}</a>)}
    </nav>
  </PageHero>

  {themes.map(({ t, Content }, i) => (
    <section id={t.id} class:list={['section', 'theme', { 'section--tint': i % 2 === 1, flip: i % 2 === 1 }]}>
      <div class="container theme-grid">
        <div class="visual">
          {t.data.image ? (
            <img src={t.data.image} alt="" loading="lazy" />
          ) : (
            <div class="placeholder">
              <Icon name={t.data.icon} size={96} />
              <span class="big-num">0{i + 1}</span>
            </div>
          )}
        </div>
        <div class="copy">
          <p class="eyebrow">Theme 0{i + 1}</p>
          <h2>{t.data.title}</h2>
          <div class="divider"><span></span></div>
          {t.data.question && <blockquote>{t.data.question}</blockquote>}
          <div class="prose"><Content /></div>
        </div>
      </div>
    </section>
  ))}
</Base>
<style>
  .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .jump a { display: inline-flex; gap: 10px; align-items: center; padding: 9px 18px; border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--navy); text-decoration: none; font-size: 0.92rem; font-weight: 500; }
  .jump a span { color: var(--teal); font-family: var(--font-head); }
  .jump a:hover { border-color: var(--teal); color: var(--teal); }
  .theme { scroll-margin-top: 76px; }
  .theme-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 72px; align-items: start; }
  .flip .visual { order: 2; }
  .visual { position: sticky; top: 110px; }
  .visual img { width: 100%; aspect-ratio: 4 / 3.4; object-fit: cover; border-radius: var(--radius); }
  .placeholder {
    aspect-ratio: 4 / 3.4; border-radius: var(--radius); position: relative; overflow: hidden;
    background: radial-gradient(circle at 30% 30%, #fff, var(--teal-light)); border: 1px solid var(--line);
    display: flex; align-items: center; justify-content: center; color: var(--teal);
  }
  .placeholder :global(svg) { stroke-width: 0.9; }
  .placeholder::before { content: ''; position: absolute; width: 70%; aspect-ratio: 1; border-radius: 50%; border: 1.5px solid var(--navy); opacity: 0.12; }
  .big-num { position: absolute; bottom: 18px; right: 24px; font-family: var(--font-head); font-size: 3rem; color: var(--navy); opacity: 0.12; }
  blockquote {
    margin: 0 0 28px; padding: 4px 0 4px 22px; border-left: 3px solid var(--teal);
    font-family: var(--font-head); font-size: 1.32rem; line-height: 1.45; color: var(--navy);
  }
  .copy .prose { font-size: 1.05rem; }
  @media (max-width: 920px) {
    .theme-grid { grid-template-columns: 1fr; gap: 36px; }
    .flip .visual { order: 0; }
    .visual { position: static; max-width: 520px; }
  }
</style>
